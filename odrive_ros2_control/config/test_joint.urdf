<?xml version="1.0"?>
<robot name="test_joint_robot">
  <link name="base_link"/>
  <link name="arm_link"/>

  <joint name="test_joint" type="continuous">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <ros2_control name="CoraTestJoint" type="system">
    <hardware>
      <plugin>odrive_ros2_control_plugin/odriveHardwareInterface</plugin>
      <param name="can">can0</param>
    </hardware>
    <joint name="test_joint">
      <param name="node_id">0</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>
  </ros2_control>
</robot>
