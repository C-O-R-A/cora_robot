<?xml version="1.0"?>
<robot name="test_joint_robot">

  <link name="base_link"/>
  <link name="arm_link_1"/>
  <link name="arm_link_2"/>

  <!-- Joint 1 -->
  <joint name="test_joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link_1"/>

    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14159265"
      upper="3.14159265"
      effort="10.0"
      velocity="3.0"/>
  </joint>

  <!-- Joint 2 -->
  <joint name="test_joint_2" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>

    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14159265"
      upper="3.14159265"
      effort="10.0"
      velocity="3.0"/>
  </joint>


  <ros2_control name="CoraTestJoint" type="system">

    <hardware>
      <plugin>odrive_ros2_control_plugin/odriveHardwareInterface</plugin>
      <param name="can">can0</param>
    </hardware>

    <joint name="test_joint_1">
      <param name="node_id">0</param>
      <param name="transmission">-107.429</param>

      <command_interface name="position"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="test_joint_2">
      <param name="node_id">3</param>
      <param name="transmission">-107.429</param>

      <command_interface name="position"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
