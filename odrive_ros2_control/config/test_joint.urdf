<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="robot_name" value="my_robot" />

  <link name="base_link">
    <inertial>
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>

  <!-- ─── Joints ─────────────────────────────────────────── -->
  <xacro:include filename="$(find R105_description)/urdf/R105.urdf.xacro"/>

  <xacro:R105
    prefix="J1"
    parent_connection="base_link"
    input="joint_in"
    lower="-3.14159"
    upper="3.14159">
    <origin xyz="0.000000 0.000000 0.000000"
            rpy="0.000000 0.000000 0.000000"/>
  </xacro:R105>

  <xacro:R105
    prefix="J2"
    parent_connection="J1_joint_out"
    input="joint_in"
    lower="-3.14159"
    upper="3.14159">
    <origin xyz="0.000000 0.000000 0.000000"
            rpy="0.000000 0.000000 0.000000"/>
  </xacro:R105>

  <xacro:R105
    prefix="J3"
    parent_connection="J2_joint_out"
    input="joint_in"
    lower="-3.14159"
    upper="3.14159">
    <origin xyz="0.000000 0.000000 0.000000"
            rpy="0.000000 0.000000 0.000000"/>
  </xacro:R105>

  <ros2_control name="CoraTestJoint" type="system">

    <hardware>
      <plugin>odrive_ros2_control_plugin/odriveHardwareInterface</plugin>
      <param name="can">can0</param>
      <param name="initial_positions_file">/home/matt/Desktop/CORA/Software/cora_robot/src/cora_common/cora_moveit_config/config/initial_positions.yaml</param>
    </hardware>

    <joint name="J1">
      <param name="node_id">3</param>
      <param name="transmission">-107.429</param>
      <param name="pos_gain">120.0</param>
      <param name="vel_gain">0.01</param>
      <param name="vel_integrator_gain">0</param>

      <command_interface name="position"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="J2">
      <param name="node_id">10</param>
      <param name="transmission">-107.429</param>
      <param name="pos_gain">120.0</param>
      <param name="vel_gain">0.01</param>
      <param name="vel_integrator_gain">0</param>

      <command_interface name="position"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="J3">
      <param name="node_id">0</param>
      <param name="transmission">-107.429</param>
      <param name="pos_gain">120.0</param>
      <param name="vel_gain">0.01</param>
      <param name="vel_integrator_gain">0</param>

      <command_interface name="position"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
